{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_azure_openai_api_version": {
        "type": "string"
      },
      "agent_azure_openai_endpoint": {
        "type": "string"
      },
      "agent_model_name": {
        "type": "string"
      },
      "agent_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "green_openai_api_key": {
        "type": "string"
      }
    },
    "required": [
      "green_openai_api_key",
      "agent_openai_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {},
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/browsecomp-plus/refs/heads/main/amber-manifest.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/paulwhitten/AgentWhetters-general-purple/refs/heads/main/amber-manifest.json5",
      "config": {
        "azure_openai_api_version": "${config.agent_azure_openai_api_version}",
        "azure_openai_endpoint": "${config.agent_azure_openai_endpoint}",
        "model_name": "${config.agent_model_name}",
        "openai_api_key": "${config.agent_openai_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019e045d-0529-7fa2-a52b-5304451cbc35",
      "agent": "019e71e8-664d-73b1-9bde-6b004e555e2c"
    }
  }
}