{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_openai_api_key": {
        "type": "string",
        "secret": true,
        "description": "OpenAI API key injected by AgentBeats/Amber at runtime."
      },
      "green_openai_api_key": {
        "type": "string"
      }
    },
    "required": [
      "green_openai_api_key",
      "agent_openai_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "track": "browsecomp-plus",
          "agent_mode": "browsecomp_plus",
          "answer_format": "final_answer_only",
          "diagnostics": true
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/browsecomp-plus/refs/heads/main/amber-manifest.json5",
      "config": {
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/ivanjojo369/AegisForge_agent/main/amber/amber-manifest-officeqa-purple.json5",
      "config": {
        "openai_api_key": "${config.agent_openai_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019e045d-0529-7fa2-a52b-5304451cbc35",
      "agent": "019e2db7-2a23-7673-a2f4-e09ec4bbf4d1"
    }
  }
}